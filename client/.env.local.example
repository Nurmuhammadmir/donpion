# Base URL of the flower-shop-server API (see ../server)
NEXT_PUBLIC_API_URL=http://localhost:4100/api

# Public site URL — used to build canonical URLs, sitemap.xml and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret with server/.env's REVALIDATE_SECRET — lets the server tell
# this app "data changed, refresh your cache now" instead of waiting for the
# ISR window to expire. Must match exactly on both sides.
REVALIDATE_SECRET=change-this-to-a-long-random-string

# Click.uz online payment — same SERVICE_ID/MERCHANT_ID as server/.env's
# CLICK_SERVICE_ID/CLICK_MERCHANT_ID (not secret; they're part of the plain
# checkout redirect URL). The actual secret key lives only in server/.env.
NEXT_PUBLIC_CLICK_SERVICE_ID=
NEXT_PUBLIC_CLICK_MERCHANT_ID=
