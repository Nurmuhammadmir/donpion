# The VPS this runs on has a CPU without x86-64-v2 support (no sse4_2) —
# sharp's prebuilt binaries silently "install" but crash at runtime on that
# hardware (see the .npmrc-less saga this fixed: hours of debugging
# "Cannot read properties of undefined (reading 'endsWith')" and
# "Unsupported CPU: Prebuilt binaries for Linux x64 require v2
# microarchitecture"). Forcing a source build every install sidesteps the
# broken prebuild-install detection entirely — sharp then correctly finds
# and links against the system libvips (apt install libvips-dev) instead.
build-from-source=true
