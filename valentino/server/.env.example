# MongoDB connection string (MongoDB Atlas or self-hosted) — separate
# database from the donpion deployment, even though both can live on the
# same MongoDB instance (just a different db name at the end of the URI).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/valentino-shop

# Server
PORT=4200
CLIENT_URL=http://localhost:3001
ADMIN_URL=http://localhost:5174

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed admin user (created by `npm run seed`)
SEED_ADMIN_EMAIL=admin@valentino.uz
SEED_ADMIN_PASSWORD=change-me-now

# Shared secret with client/.env.local's REVALIDATE_SECRET — after any admin
# write (product/category/character/settings), the server pings the client's
# /api/revalidate with this secret so changes show up immediately instead of
# waiting for the ISR cache window to expire. Must match exactly.
REVALIDATE_SECRET=change-this-to-a-long-random-string

# Customer login (phone + Telegram code, required before checkout). Tries
# Telegram Gateway first (sign up at https://gateway.telegram.org for the
# access token — instant delivery, ~$0.01/code, needs account balance); if
# that's unset/unfunded, falls back to the bot below (free, create one with
# @BotFather — requires opening it and pressing Start).
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Click.uz online payment (merchant.click.uz → Сервисы). SERVICE_ID and
# MERCHANT_ID aren't secret — they're also sent to the client as
# NEXT_PUBLIC_CLICK_* (see client/.env.example) since they live in the plain
# payment-redirect URL. CLICK_SECRET_KEY must stay server-only: it's what
# proves a Prepare/Complete request (routes/click.routes.js) actually came
# from Click and not a forged request.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
